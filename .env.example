BOT_TOKEN=your_telegram_bot_token

# Groq API (https://console.groq.com/keys)
GROQ_API_KEY=gsk_...
GROQ_MODEL=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=

# Локальный llama.cpp сервер (опционально)
LLAMACPP_URL=http://localhost:11434
LLAMACPP_MODEL=Qwen2.5-7B-Instruct-Q4_K_M

# Tavily Search API (https://tavily.com)
TAVILY_API_KEY=tvly-...

APP_URL=http://localhost:8080
WEBHOOK_PORT=8080
PAID_PLAN_DAYS=30

# --- Tribute оплата ---
# Прямая ссылка на донат из кабинета Tribute
TRIBUTE_DONATE_URL=https://web.tribute.tg/d/NPF
# Твой Telegram ID — получаешь уведомления и можешь активировать: /activate <user_id>
ADMIN_TELEGRAM_ID=0
