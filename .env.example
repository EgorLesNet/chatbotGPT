BOT_TOKEN=your_telegram_bot_token

# Groq API (https://console.groq.com/keys)
GROQ_API_KEY=gsk_...
GROQ_MODEL=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=

# Локальный llama.cpp сервер (опционально)
LLAMACPP_URL=http://localhost:11434
LLAMACPP_MODEL=Qwen2.5-7B-Instruct-Q4_K_M

# Tavily Search API (https://tavily.com)
TAVILY_API_KEY=tvly-...

APP_URL=http://localhost:8080
WEBHOOK_PORT=8080
PAID_PLAN_DAYS=30

# --- Tribute оплата ---
# Username бота Tribute (https://t.me/tribute)
TRIBUTE_BOT_USERNAME=tribute
# Slug продукта в Tribute (создаёшь в кабинете)
TRIBUTE_PRODUCT_SLUG=prorab-paid
# Твой Telegram ID — получаешь уведомления и используешь /activate
ADMIN_TELEGRAM_ID=0
