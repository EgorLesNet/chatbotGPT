{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web/",
      "framework": "nextjs"
    },
    "bot": {
      "root": "./",
      "framework": "fastapi",
      "entrypoint": "index:app"
    }
  },
  "rewrites": [
    { "source": "/api/webhook", "destination": { "service": "bot" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
